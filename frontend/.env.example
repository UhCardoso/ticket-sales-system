# Base da API. Em dev fica como /api: o proxy do Vite (vite.config.ts) encaminha para o
# backend na mesma origem, então o navegador não passa por CORS. Em produção, aponte para
# a URL real da API (ex.: https://api.exemplo.com/api).
VITE_API_BASE_URL=/api

# Destino do proxy de dev. Deve casar com APP_PORT do backend/.env.
API_PROXY_TARGET=http://localhost:8000

# Intervalo do polling do painel, em ms. O snapshot do backend vive 3s em cache
# (DASHBOARD_CACHE_TTL), então pedir mais rápido que isso só devolve o mesmo dado.
VITE_POLL_INTERVAL=5000

# Timeout de cada request, em ms.
VITE_API_TIMEOUT=10000
